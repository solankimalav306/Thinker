{
  "name": "thinker",
  "productName": "Thinker",
  "version": "1.0.0",
  "description": "AI-Powered PDF Reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "launch.bat",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "keywords": [],
  "author": "Thinker",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.thinker.app",
    "productName": "Thinker",
    "copyright": "Copyright © 2025 Thinker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app-storage.js",
      "llm-handler.js",
      "renderer/**/*",
      "!renderer/sample.pdf",
      "!renderer/sample2.pdf",
      "node_modules/**/*",
      ".env"
    ],
    "extraResources": [
      {
        "from": "backend.exe",
        "to": "backend.exe",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "renderer/assets/logoWhite.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Thinker"
    }
  },
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^16.6.1",
    "mermaid": "^11.14.0",
    "pdf-lib": "^1.17.1"
  }
}
